# Copy to .env for local use. NEVER commit a real .env -- it is gitignored.
# In production these are set in the Vercel dashboard, not in a file.

# --- Pick ONE provider ---------------------------------------------------

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini (has a free tier) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Only needed if BOTH keys above are set: "anthropic" | "gemini"
# LLM_PROVIDER=anthropic

# --- Required ------------------------------------------------------------
# Any word. The backend REFUSES TO SERVE without this: a missing passcode
# used to mean an open endpoint spending your API credit, and scanners find
# public endpoints within days. Set ALLOW_NO_PASSCODE=1 to override, knowingly.
PRESENCE_PASSCODE=

# Requests per hour per IP, per warm instance. Default 120.
# RATE_PER_HOUR=120

# Output length. Unset means no cap: the model stops when it has finished,
# which is what stops long replies being cut off mid-sentence. Set a number
# to re-impose a ceiling.
# MAX_TOKENS_CAP=1400

# --- Input bounds --------------------------------------------------------
# Output is uncapped, so input size is what bounds the cost of a request.
# MAX_INPUT_CHARS=120000
# MAX_MESSAGES=200
# MAX_SYSTEM_CHARS=20000

# How long to wait on the model before giving up.
# UPSTREAM_TIMEOUT_MS=60000
